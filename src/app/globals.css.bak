@import "tailwindcss";

@layer base {
  :root {
    --green: #58CC02;
    --green-dark: #4CAF00;
    --green-light: #89E219;
    --blue: #1CB0F6;
    --blue-dark: #1899D6;
    --orange: #FF9600;
    --red: #FF4B4B;
    --purple: #CE82FF;
    --yellow: #FFD900;
    --bg: #FFFFFF;
    --bg-secondary: #F7F7F7;
    --text: #1C1C1C;
    --text-muted: #777777;
    --border: #E5E5E5;
    --card: #FFFFFF;
    --shadow: 0 4px 0 rgba(0,0,0,0.12);
  }

  .dark {
    --bg: #131f24;
    --bg-secondary: #1a2e38;
    --text: #FFFFFF;
    --text-muted: #9CA3AF;
    --border: #2d4a5a;
    --card: #1a2e38;
    --shadow: 0 4px 0 rgba(0,0,0,0.4);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-tap-highlight-color: transparent;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-inter), system-ui, sans-serif;
    min-height: 100vh;
    min-height: -webkit-fill-available; /* Fix for older Safari */
    transition: background-color 0.3s ease, color 0.3s ease;
    overflow-x: hidden;
  }

  html {
    height: -webkit-fill-available;
  }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 999px; }
  ::-webkit-scrollbar-thumb:hover { background: #aaa; }
}

/* Khmer font support */
.khmer-text {
  font-family: var(--font-khmer), 'Khmer OS', 'Khmer', system-ui, sans-serif;
  line-height: 1.85; /* Increased for iOS subscripts */
  padding-bottom: 0.1em; /* Extra space for subscripts */
}

/* Duolingo-style buttons */
.btn-primary {
  background: var(--green);
  color: white;
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 14px 32px;
  border-radius: 16px;
  border: none;
  border-bottom: 4px solid var(--green-dark);
  cursor: pointer;
  transition: all 0.1s ease;
  user-select: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.btn-primary:hover {
  background: #65e003;
  transform: translateY(-1px);
}

.btn-primary:active {
  border-bottom-width: 2px;
  transform: translateY(2px);
}

.btn-secondary {
  background: transparent;
  color: var(--green);
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 13px 32px;
  border-radius: 16px;
  border: 2px solid var(--green);
  cursor: pointer;
  transition: all 0.15s ease;
}

.btn-secondary:hover {
  background: rgba(88, 204, 2, 0.1);
}

.btn-danger {
  background: var(--red);
  color: white;
  font-weight: 700;
  padding: 14px 32px;
  border-radius: 16px;
  border: none;
  border-bottom: 4px solid #cc3c3c;
  cursor: pointer;
  transition: all 0.1s ease;
}

.btn-danger:active {
  border-bottom-width: 2px;
  transform: translateY(2px);
}

/* Card styles */
.card {
  background: var(--card);
  border-radius: 20px;
  border: 2px solid var(--border);
  padding: 20px;
  box-shadow: var(--shadow);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 0 rgba(0,0,0,0.12);
}

/* XP Bar */
.xp-bar {
  height: 20px;
  background: var(--border);
  border-radius: 999px;
  overflow: hidden;
  position: relative;
}

.xp-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--green), var(--green-light));
  border-radius: 999px;
  transition: width 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
}

.xp-fill::after {
  content: '';
  position: absolute;
  top: 4px;
  left: 8px;
  right: 8px;
  height: 4px;
  background: rgba(255,255,255,0.4);
  border-radius: 999px;
}

/* Heart icon */
.heart { color: var(--red); font-size: 1.4rem; }
.heart-empty { color: var(--border); font-size: 1.4rem; }

/* Streak fire */
.streak-fire { color: var(--orange); font-size: 1.5rem; }

/* Quiz options */
.quiz-option {
  background: var(--card);
  border: 2px solid var(--border);
  border-radius: 16px;
  padding: 16px 20px;
  cursor: pointer;
  tran